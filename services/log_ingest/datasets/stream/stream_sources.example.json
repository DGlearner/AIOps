{
  "batch_size": 5,
  "rate_per_second": 10,
  "sources": [
    {
      "name": "linux-auth-prod",
      "source_type": "linux",
      "source_name": "auth.log",
      "host": "app-prod-01",
      "file": "linux_auth.log",
      "batch_size": 5,
      "rate_per_second": 10,
      "enabled": true
    },
    {
      "name": "linux-syslog-prod",
      "source_type": "linux",
      "source_name": "syslog",
      "host": "app-prod-01",
      "file": "linux_syslog.log",
      "batch_size": 5,
      "rate_per_second": 20,
      "enabled": true
    },
    {
      "name": "mysql-error-prod",
      "source_type": "mysql",
      "source_name": "mysql-error.log",
      "host": "db-prod-01",
      "file": "mysql_error.log",
      "batch_size": 5,
      "rate_per_second": 8,
      "service": "mysql",
      "enabled": true
    },
    {
      "name": "mysql-slow-query-prod",
      "source_type": "mysql",
      "source_name": "mysql-slow.log",
      "host": "db-prod-01",
      "file": "mysql_slow_query.log",
