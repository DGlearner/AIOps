      "host": "app-prod-02",
      "file": "app_payment_service.log",
      "batch_size": 5,
      "rate_per_second": 8,
      "service": "payment-service",
      "enabled": true
    },
    {
      "name": "app-order-service",
      "source_type": "app_service",
      "source_name": "order-service.log",
      "host": "app-prod-02",
      "file": "app_order_service.log",
      "batch_size": 5,
      "rate_per_second": 8,
      "service": "order-service",
      "enabled": true
